# ==============================================================================
# YerooTech SaaS Attendance Management System - Environment Configuration
# ==============================================================================

# General Settings
DJANGO_SECRET_KEY=django-insecure-dev-key-change-in-production-yerootech-2026
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# ==============================================================================
# Database Configuration
# ==============================================================================
# 1) Default (SQLite - zero config, instant local development):
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=db.sqlite3

# 2) For PostgreSQL (uncomment below and adjust credentials):
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=yerootech
# DB_USER=postgres
# DB_PASSWORD=your_password
# DB_HOST=localhost
# DB_PORT=5432

# ==============================================================================
# CORS & Frontend Origins
# ==============================================================================
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ==============================================================================
# Attendance Engine Parameters
# ==============================================================================
QR_CODE_EXPIRY_SECONDS=300
GPS_DEFAULT_RADIUS_METERS=100
PIN_CODE_EXPIRY_SECONDS=600

# ==============================================================================
# Google OAuth (Optional - for Social Sign-in)
# ==============================================================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ==============================================================================
# Celery & Redis (Optional - for Asynchronous Background Tasks)
# ==============================================================================
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
